+	uint32		readbackIcr;
+	uint32		esr;
+	uint32		elapsedUs;
+	bool		timedOut;
+};
+
+static const uint32 kMaxIPITrace = 12;
+static ipi_step_trace sIpiTrace[kMaxIPITrace];
+static uint32 sIpiTraceCount;
+
+// Microseconds spent in each segment of one INIT/SIPI sequence, by the
+// loader's own TSC clock. Indices: 0 esr-clear, 1 init-assert write, 2
+// init-assert wait, 3 init-deassert write, 4 init-deassert wait, 5 init-to-sipi (no wait since the fix),
+// 6 sipi-1 write, 7 sipi-1 spin(200), 8 sipi-1 wait, 9 sipi-2 write,
+// 10 sipi-2 spin(200), 11 sipi-2 wait.
+static uint32 sSegmentUs[12];
+
+// Which slice of the INIT-to-SIPI wait the 200 ms stall lands in, if any.
+static uint32 sStallSlice[4];
+static uint32 sStallSliceUs[4];
+static uint32 sStallSliceCount;
+
+// How many wake attempts were spoiled by a stall landing in the INIT-to-SIPI
+// wait. Perfectly predicts an AP that does not come up.
+static uint32 sStalledAttempts;
+
+// Kept for smp_add_safemode_menus(), which runs much later and reports these.
+static uint32 sEarlyWakeAttempt;
+static uint32 sEarlyWakeMaxAttempts;
+static const char* const kSegmentName[12] = {
+	"esr-clear", "init-assert-write", "init-assert-wait",
+	"init-deassert-write", "init-deassert-wait", "init-to-sipi",
+	"sipi1-write", "sipi1-spin200", "sipi1-wait",
+	"sipi2-write", "sipi2-spin200", "sipi2-wait"
+};
+
+#define SEGMENT_BEGIN()		bigtime_t segStart = smp_early_now_us()
+#define SEGMENT_END(index)	sSegmentUs[index] += (uint32)(smp_early_now_us() \
+								- segStart); segStart = smp_early_now_us()
+
+
+/*!	Bounded wait for the local APIC to finish sending, recording how long it
+	took and what the ICR and error status looked like afterwards.
+*/
+static bool
+smp_wait_for_delivery(const char* name, uint32 writtenIcr)
+{
+	bigtime_t start = smp_early_now_us();
+
+	uint32 timeout = kIPIDeliveryTimeout;
+	while ((apic_read(APIC_INTR_COMMAND_1) & APIC_DELIVERY_STATUS) != 0
+			&& --timeout != 0) {
+		asm volatile ("pause;");
+	}
+
+	uint32 elapsedUs = (uint32)(smp_early_now_us() - start);
+	uint32 readback = apic_read(APIC_INTR_COMMAND_1);
+
+	// The error status register latches on write, so write-then-read is the
+	// only way to see the errors raised by the send that just happened.
+	apic_write(APIC_ERROR_STATUS, 0);
+	uint32 esr = apic_read(APIC_ERROR_STATUS);
+
+	if (sIpiTraceCount < kMaxIPITrace) {
+		ipi_step_trace& step = sIpiTrace[sIpiTraceCount++];
+		step.name = name;
+		step.writtenIcr = writtenIcr;
+		step.readbackIcr = readback;
+		step.esr = esr;
+		step.elapsedUs = elapsedUs;
+		step.timedOut = timeout == 0;
+	}
+
+	return timeout != 0;
+}
+
+
+/*!	One INIT assert/de-assert plus the startup IPIs, with every wait bounded.
+	Returns false if a send never completed.
+*/
+static bool
+smp_send_init_sipi(uint32 cpu)
+{
+	uint32 apicID = gKernelArgs.arch_args.cpu_apic_id[cpu];
+	uint32 config;
+
+	SEGMENT_BEGIN();
+
+	if (gKernelArgs.arch_args.cpu_apic_version[cpu] & 0xf0) {
+		apic_write(APIC_ERROR_STATUS, 0);
+		apic_read(APIC_ERROR_STATUS);
+	}
+
+	SEGMENT_END(0);
+
+	// INIT, asserted then de-asserted
+	for (int32 phase = 0; phase < 2; phase++) {
+		config = (apic_read(APIC_INTR_COMMAND_2) & APIC_INTR_COMMAND_2_MASK)
+			| (apicID << 24);
+		apic_write(APIC_INTR_COMMAND_2, config);
+
+		config = (apic_read(APIC_INTR_COMMAND_1) & 0xfff00000)
+			| APIC_TRIGGER_MODE_LEVEL | APIC_DELIVERY_MODE_INIT
+			| (phase == 0 ? APIC_INTR_COMMAND_1_ASSERT : 0);
+		apic_write(APIC_INTR_COMMAND_1, config);
+
+		SEGMENT_END(phase == 0 ? 1 : 3);
+
+		if (!smp_wait_for_delivery(
+				phase == 0 ? "init-assert" : "init-deassert", config)) {
+			return false;
+		}
+
+		SEGMENT_END(phase == 0 ? 2 : 4);
+	}
+
+	// No wait between INIT and SIPI. The 10 ms the MP spec asks for is for
+	// discrete 82489DX APICs; Linux has used no delay on every Intel CPU from
+	// the Pentium Pro on (smp_set_init_udelay(), init_udelay = 0) and 10 us
+	// between the two SIPIs.
+	//
+	// Here the 10 ms was not just unnecessary, it was the race. After INIT
+	// the AP sits in wait-for-SIPI, and an SMI arriving in that window cannot
+	// rendezvous with it: the firmware's handler waits out its own timeout (a
+	// fixed ~311 ms, measured to within 63 us on two boots) and the AP does
+	// not start. Whether a boot got two CPUs came down to whether an SMI
+	// happened to land in those 10 ms. Sending the SIPI right away shrinks
+	// the window to microseconds.
+	SEGMENT_END(5);
+
+	uint32 numStartups
+		= (gKernelArgs.arch_args.cpu_apic_version[cpu] & 0xf0) ? 2 : 0;
+	for (uint32 j = 0; j < numStartups; j++) {
+		apic_write(APIC_ERROR_STATUS, 0);
+
+		config = (apic_read(APIC_INTR_COMMAND_2) & APIC_INTR_COMMAND_2_MASK)
+			| (apicID << 24);
+		apic_write(APIC_INTR_COMMAND_2, config);
+
+		config = (apic_read(APIC_INTR_COMMAND_1) & 0xfff0f800)
+			| APIC_DELIVERY_MODE_STARTUP | (kTrampolineCode >> 12);
+		apic_write(APIC_INTR_COMMAND_1, config);
+
+		SEGMENT_END(j == 0 ? 6 : 9);
+
+		smp_delay_us(10);
+
+		SEGMENT_END(j == 0 ? 7 : 10);
+
+		if (!smp_wait_for_delivery(j == 0 ? "sipi-1" : "sipi-2", config))
+			return false;
+
+		SEGMENT_END(j == 0 ? 8 : 11);
+	}
+
+	return true;
+}
