+// Picks a default from a capability mask, preferring the safe baseline over
+// the widest/fastest thing the hardware claims.
+//
+// Taking the maximum is wrong as a *default*. This codec advertises 192 kHz on
+// its ADC and then never delivers a buffer at that rate, and it advertises
+// 24-bit, which arrives as 24 significant bits inside a 32-bit container --
+// the media kit reads that as a plain 32-bit integer and the result is noise
+// rather than audio.
+//
+// It matters just as much on playback, though not for the same reason: an
+// unspecified request there used to fall through to the maximum and pin the
+// DAC at 192 kHz/24-bit, so the mixer resampled everything 4x and a 1.33 GHz
+// in-order Atom could not keep the DMA buffer fed. That was self-inflicted --
+// the stock driver negotiates 48 kHz because that is what the add-on asks for.
+//
+// An explicit request still wins: a caller asking for exactly 96 kHz gets it,
+// because the baseline is only preferred when it is among the options.
+static uint32
+hda_stream_preferred(uint32 mask, uint32 preferred)
+{
+	if ((mask & preferred) != 0)
+		return preferred;
+	return hda_stream_highest_bit(mask);
+}
+
+
+// Programs one stream with the requested format/rate, narrowed to what its
+// converter actually advertises.
+//
+// Both fields must end up holding exactly ONE bit: they are looked up in the
+// rate/format tables to build the stream descriptor, and a multi-bit value
+// matches no entry -- which does not fail loudly, it just leaves the stream
+// misconfigured. The requested value can legitimately be a mask, and so can
+// the intersection, so everything is reduced with hda_stream_highest_bit()
+// before being stored.
+static void
+hda_apply_format(hda_stream* stream, uint32 requestedFormat, uint32 requestedRate)
+{
+	if (stream == NULL)
+		return;
+
+	uint32 format = hda_stream_preferred(
+		requestedFormat & stream->supported_formats, B_FMT_16BIT);
+	if (format == 0)
+		format = hda_stream_preferred(stream->supported_formats, B_FMT_16BIT);
+
+	uint32 rate = hda_stream_preferred(
+		requestedRate & stream->supported_rates, B_SR_48000);
+	if (rate == 0)
+		rate = hda_stream_preferred(stream->supported_rates, B_SR_48000);
+
+	if (format == 0 || rate == 0)
+		return;
+
+	stream->sample_format = format;
+	stream->sample_rate = rate;
+	stream->sample_size = format2size(stream->sample_format);
+}
+
+
+static status_t
+set_global_format(hda_audio_group* audioGroup, multi_format_info* data)
+{
+	// Playback and record run through different converters and do not
+	// necessarily share capabilities, so each is checked against its own
+	// mask. Anything the converter did not advertise is dropped rather than
+	// programmed: the stream register accepts such a value happily and the
+	// hardware then simply never delivers a buffer, which is impossible to
+	// tell from a dead microphone. Falling back keeps the device usable.
+	hda_apply_format(audioGroup->playback_stream, data->output.format,
+		data->output.rate);
+	hda_apply_format(audioGroup->record_stream, data->input.format,
+		data->input.rate);
 
 	return B_OK;
 }
