+void
+UVCDeframer::_EmitCurrentFrame()
+{
+	fFrameCount++;
+	const uint8* buf = (uint8*)fInputBuffer.Buffer();
+	fCurrentFrame->Write(buf, fInputBuffer.BufferLength());
