+	 *
+	 * So escalate on lost association, not on recovery count. A miss that we
+	 * recover from is not evidence of a broken radio.
+	 */
+	struct ieee80211vap *vap = TAILQ_FIRST(&sc->sc_ic.ic_vaps);
+	bool associated = vap != NULL && vap->iv_state == IEEE80211_S_RUN;
+
+	if (associated) {
+		/* Recovered, still on the network: transient, not a fault. */
+		sc->sc_bmiss_count = 0;
+	} else {
+		if (ticks - sc->sc_bmiss_last_tick > 120 * hz)
+			sc->sc_bmiss_count = 0;
+		if (sc->sc_bmiss_count == 0)
+			sc->sc_bmiss_first_tick = ticks;
+		sc->sc_bmiss_count++;
+	}
+	sc->sc_bmiss_last_tick = ticks;
+
+	/*
+	 * Power-cycling the adapter is not an upstream recovery: upstream only
+	 * does a link-preserving reset here. It was added for one card that
