diff --git a/src/add-ons/kernel/drivers/power/sony_ec/sony_ec.cpp b/src/add-ons/kernel/drivers/power/sony_ec/sony_ec.cpp
new file mode 100644
index 00000000..8e2760c6
--- /dev/null
+++ b/src/add-ons/kernel/drivers/power/sony_ec/sony_ec.cpp
@@ -0,0 +1,776 @@
+/*
+ * Copyright 2026, Haiku, Inc. All rights reserved.
+ * Distributed under the terms of the MIT License.
+ *
+ * Driver for the Sony "SNC" notebook control ACPI device (HID "SNY5001"),
+ * found on Sony VAIO laptops of this era.
+ *
+ * This does NOT reimplement Linux's sony-laptop.c (which is GPL licensed
+ * and can't be copied into this MIT-licensed tree); it's an independent
+ * implementation written from an understanding of the SNC calling
+ * convention gathered by reading that driver, Sony's own published ACPI
+ * SNC readme, and this model's disassembled DSDT. The convention, in
+ * short:
+ *
+ *   - The SNC device exposes up to 16 "capability" slots. Calling SN00
+ *     with an argument of (slot + 0x20) returns the vendor-defined
+ *     "handle" value assigned to that slot on this particular model (0
+ *     if unused). Which handle ends up in which slot is BIOS/model
+ *     specific and has to be discovered at runtime -- there is no fixed
+ *     mapping.
+ *   - SN02 takes a bitmask (obtained via SN00 with argument 0x10) and
+ *     enables ACPI Notify events for the capabilities present.
+ *   - Runtime ACPI Notify events on the SNC device use codes of
+ *     (0x90 + slot), i.e. they identify a slot, not a handle directly;
+ *     the handle has to be looked back up from the table above.
+ *   - SN05 acknowledges/clears an event for a given slot.
+ *   - SN07 dispatches to a per-handle sub-function, selected by the
+ *     argument's bit 8-15 (bit 16-23 is a further control byte for
+ *     writes). On this model, handle 0x0124 is the wireless kill switch:
+ *     sub-function 3 reads the persistent H8EC.WLPW (radio power) and
+ *     H8EC.WLSL (status LED) bits back (bit 0 / bit 1 of the result),
+ *     sub-function 4 writes them the same way. The indicator LED next to
+ *     the switch does not visibly respond to H8EC.WLSL either way (0 or
+ *     1, confirmed via direct register readback) -- it appears to be
+ *     wired directly to the physical switch rather than driven by the
+ *     EC, so this driver no longer tries to control it.
+ *   - Screen brightness is a separate, simpler pair of methods: GBRT
+ *     (get, no argument) and SBRT (set, one integer argument), which
+ *     don't go through the capability table at all.
+ */
+
+
+#include <ACPI.h>
+#include <PCI.h>
+#include <bus/PCI.h>
+#include <drivers/backlight.h>
+
+#include <KernelExport.h>
+#include <stdio.h>
+
+#include <stdlib.h>
+#include <string.h>
+
+
+#define SONY_EC_MODULE_NAME "drivers/power/sony_ec/driver_v1"
+#define SONY_EC_DEVICE_MODULE_NAME "drivers/power/sony_ec/device_v1"
+
+#define SONY_EC_HID "SNY5001"
+
+#define SONY_EC_CAP_SLOT_COUNT 16
+#define SONY_EC_CAP_SLOT_BASE 0x20
+#define SONY_EC_EVENT_BASE 0x90
+
+#define ERROR(x...)	dprintf("sony_ec: " x)
+#define TRACE(x...)	dprintf("sony_ec: " x)
+
+
+static device_manager_info *sDeviceManager;
+static struct acpi_module_info *sAcpi;
+static pci_module_info *sPci;
+
+// SBRT (see below) only ever gets as far as the SNC's own scratch register
+// (LCDB/BCLP) and a "backlight changed" notification (ASLE) meant for the
+// Intel graphics driver to act on; nothing acts on it without that driver,
+// which Haiku doesn't have for this PowerVR SGX-based Poulsbo/GMA500 chip
+// (see the "graphics acceleration" entry in the VAIO P README). This was
+// first attempted by guessing the classic Intel mobile "BLC_PWM_CTL" MMIO
+// register (bits 31:16 period, bits 15:0 duty) -- it visibly changed the
+// backlight, proving *some* register in that guessed offset affects it,
+// but the perceived brightness order across levels 0-8 was scrambled, not
+// monotonic, even though the computed duty cycle written was confirmed
+// monotonic via readback. That's consistent with having hit the wrong
+// register/offset for this chip's actual display-block layout (Poulsbo's
+// SCH-integrated GPU isn't guaranteed to match mainline i915's memory
+// map) rather than a real duty-cycle-vs-perception mismatch.
+//
+// The Intel SCH US15W datasheet (doc 319537, Graphics/Video/Display D2:F0
+// section) documents the real mechanism instead: the "LBB" (Legacy
+// Backlight Brightness) register at PCI config offset 0xF4, bits 7:0 --
+// a plain 0 (dimmest) - 255 (brightest) value, no period/duty math
+// needed. The datasheet explicitly notes that writing only the low byte
+// (not a 16- or 32-bit access touching the upper "scratch trigger" bits
+// at 0xF5-0xF7) avoids generating a display event interrupt, so this
+// writes exactly one byte.
+#define POULSBO_GFX_VENDOR_ID	0x8086
+#define POULSBO_GFX_DEVICE_ID	0x8108
+#define LBB_REGISTER_OFFSET		0xF4
+
+static bool sGfxFound;
+static uint8 sGfxBus, sGfxDevice, sGfxFunction;
+
+
+typedef struct {
+	device_node *node;
+	acpi_device_module_info *acpi;
+	acpi_device acpi_cookie;
+
+	uint16 capabilities[SONY_EC_CAP_SLOT_COUNT];
+	uint32 brightness;
+} sony_ec_device_info;
+
+static sony_ec_device_info *sSonyEcDevice;
+
+static status_t sony_ec_set_brightness(sony_ec_device_info *device,
+	uint32 level);
+
+
+static status_t
+sony_ec_call_int(sony_ec_device_info *device, const char *method,
+	bool hasArgument, uint32 argument, uint32 *_result)
+{
+	acpi_object_type argumentObject;
+	acpi_objects arguments;
+	acpi_objects *argumentsPointer = NULL;
+
+	if (hasArgument) {
+		argumentObject.object_type = ACPI_TYPE_INTEGER;
+		argumentObject.integer.integer = argument;
+		arguments.count = 1;
+		arguments.pointer = &argumentObject;
+		argumentsPointer = &arguments;
+	}
+
+	uint8 resultBuffer[64];
+	memset(resultBuffer, 0, sizeof(resultBuffer));
+	acpi_data buffer;
+	buffer.pointer = resultBuffer;
+	buffer.length = sizeof(resultBuffer);
+
+	status_t status = device->acpi->evaluate_method(device->acpi_cookie,
+		method, argumentsPointer, &buffer);
+	if (status != B_OK)
+		return status;
+
+	// Some SNC methods (SBRT in particular) are setters with no meaningful
+	// return value -- the AML has no Return statement, so the buffer stays
+	// empty. That's not a failure: the method call itself already
+	// succeeded above. Only decode a result if the callee actually wants
+	// one and something recognizable came back; otherwise just report
+	// success with *_result left untouched.
+	if (buffer.length == 0)
+		return B_OK;
+
+	acpi_object_type *object = (acpi_object_type *)buffer.pointer;
+	if (object->object_type == ACPI_TYPE_INTEGER) {
+		*_result = (uint32)object->integer.integer;
+		return B_OK;
+	}
+
+	if (object->object_type == ACPI_TYPE_BUFFER && object->buffer.length >= 1) {
+		uint32 value = 0;
+		size_t count = min_c(object->buffer.length, sizeof(value));
+		memcpy(&value, object->buffer.buffer, count);
+		*_result = value;
+		return B_OK;
+	}
+
+	return B_OK;
+}
+
+
+static status_t
+sony_ec_call_handle(sony_ec_device_info *device, uint16 handle,
+	uint32 argument, uint32 *_result)
+{
+	for (int32 i = 0; i < SONY_EC_CAP_SLOT_COUNT; i++) {
+		if (device->capabilities[i] != handle)
+			continue;
+
+		return sony_ec_call_int(device, "SN07", true, i | argument, _result);
+	}
+
+	return B_ENTRY_NOT_FOUND;
+}
+
+
+static void
+sony_ec_probe_capabilities(sony_ec_device_info *device)
+{
+	for (int32 i = 0; i < SONY_EC_CAP_SLOT_COUNT; i++) {
+		uint32 result = 0;
+		status_t status = sony_ec_call_int(device, "SN00", true,
+			SONY_EC_CAP_SLOT_BASE + i, &result);
+		device->capabilities[i] = (status == B_OK) ? (uint16)result : 0;
+		if (status == B_OK && result != 0) {
+			TRACE("capability slot %" B_PRId32 ": handle 0x%04" B_PRIx32
+				"\n", i, result);
+		}
+	}
+
+	// The hotkey handles need to be "armed" once with a 0 argument before
+	// they start generating Notify events for Fn key presses -- unlike
+	// e.g. the wireless kill switch handle, which reports events out of
+	// the box.
+	static const uint16 kHotkeyHandles[] = { 0x0100, 0x0101, 0x0102, 0x0127 };
+	for (size_t i = 0; i < B_COUNT_OF(kHotkeyHandles); i++) {
+		uint32 result = 0;
+		status_t status = sony_ec_call_handle(device, kHotkeyHandles[i], 0,
+			&result);
+		if (status == B_OK) {
+			TRACE("armed hotkey handle 0x%04x\n", kHotkeyHandles[i]);
+		}
+	}
+
+	uint32 brightness = 0;
+	if (sony_ec_call_int(device, "GBRT", false, 0, &brightness) == B_OK) {
+		device->brightness = brightness;
+		TRACE("current brightness (GBRT): %" B_PRIu32 "\n", brightness);
+	} else {
+		TRACE("GBRT not available on this model\n");
+	}
+
+	uint32 eventMask = 0;
+	if (sony_ec_call_int(device, "SN00", true, 0x10, &eventMask) == B_OK) {
+		uint32 enableResult = 0;
+		status_t status = sony_ec_call_int(device, "SN02", true, eventMask,
+			&enableResult);
+		TRACE("enabling events (mask 0x%04" B_PRIx32 "): %s\n", eventMask,
+			strerror(status));
+	}
+}
+
+
+static void
+sony_ec_notify_handler(acpi_handle _device, uint32 value, void *context)
+{
+	sony_ec_device_info *device = (sony_ec_device_info *)context;
+
+	TRACE("notify event 0x%04" B_PRIx32 "\n", value);
+
+	if (value < SONY_EC_EVENT_BASE)
+		return;
+
+	uint32 offset = value - SONY_EC_EVENT_BASE;
+	if (offset >= SONY_EC_CAP_SLOT_COUNT) {
+		ERROR("notify event 0x%04" B_PRIx32 " is outside the capability "
+			"table\n", value);
+		return;
+	}
+
+	TRACE("notify event 0x%04" B_PRIx32 " -> slot %" B_PRIu32
+		" -> handle 0x%04x\n", value, offset, device->capabilities[offset]);
+
+	uint32 clearResult = 0;
+	sony_ec_call_int(device, "SN05", true, 1 << offset, &clearResult);
+
+	if (device->capabilities[offset] == 0x0124) {
+		// Wireless switch changed state. Re-request WLAN power on (handle
+		// 0x0124, sub-function 4) every time this fires, not just once at
+		// boot -- the DSDT's F124 method only turns H8EC.WLPW on when
+		// explicitly asked to (it unconditionally zeroes it when the
+		// hardware RF-kill line is asserted, i.e. switch off, but does
+		// NOT automatically restore it when the switch goes back on). A
+		// single boot-time-only request left the radio never coming back
+		// after an off/on cycle. This runs well after boot, triggered only
+		// by an actual physical toggle, so it doesn't collide with the
+		// USB/ATA enumeration window a boot-time call did.
+		//
+		// The control byte's bit 0x01 maps to H8EC.WLPW (radio power) and
+		// bit 0x02 maps to H8EC.WLSL (status LED); both are set here to
+		// match the DSDT's own intent, though WLSL has been confirmed (via
+		// direct register readback) to have no visible effect on the
+		// physical indicator LED on this unit -- it appears to be hardware
+		// wired to the switch rather than EC controlled.
+		uint32 wlanPowerResult = 0;
+		status_t wlanPowerStatus = sony_ec_call_handle(device, 0x0124,
+			0x030400, &wlanPowerResult);
+		TRACE("wireless switch toggled: re-requesting WLAN power on: %s\n",
+			strerror(wlanPowerStatus));
+
+		// Also request Bluetooth power (sub-function 6 writes H8EC.BTPW/
+		// BTSL, the BT analogs of WLPW/WLSL; sub-function 5 reads them
+		// back). The internal Bluetooth module's USB port detects a
+		// connection (its presence pull-up runs off standby power) but the
+		// module never answers a single control transfer -- exactly what a
+		// logic-power-gated device looks like -- and nothing anywhere ever
+		// turns BTPW on: Haiku has no Sony BT power driver, and the EC
+		// doesn't do it by itself on switch-on either (same as it doesn't
+		// for WLPW above).
+		uint32 btPowerResult = 0;
+		status_t btPowerStatus = sony_ec_call_handle(device, 0x0124,
+			0x030600, &btPowerResult);
+		uint32 btStateResult = 0;
+		status_t btStateStatus = sony_ec_call_handle(device, 0x0124,
+			0x0500, &btStateResult);
+		TRACE("wireless switch toggled: requesting BT power on: %s, "
+			"readback (sub-function 5): %s, value 0x%04" B_PRIx32 "\n",
+			strerror(btPowerStatus), strerror(btStateStatus), btStateResult);
+	} else if (device->capabilities[offset] == 0x0100) {
+		// Per this model's DSDT: handle 0x0100 is a shared notify for every
+		// Fn+Fn-row key (F1-F12 all funnel into the same EC query numbers,
+		// _Q0A/_Q0B, and the same SNNE(0x0100) call) -- unlike 0x0124, it
+		// does NOT identify which key by itself. Immediately before firing
+		// the notify, the DSDT stashes the actual key code from
+		// H8EC.HKCD into SNC.ECR; F100's sub-function 2 (BUF1 = 2) reads
+		// that back as BUF0. Log the raw code here -- undocumented outside
+		// this table, and deliberately not guessed from Linux's
+		// sony-laptop.c (see the file header) -- so a real Fn+F1..F12 press
+		// can be matched key-by-key to its code before wiring up actual
+		// actions (brightness, volume, etc.).
+		uint32 hotkeyResult = 0;
+		status_t hotkeyStatus = sony_ec_call_handle(device, 0x0100, 0x0200,
+			&hotkeyResult);
+		// SNCF() returns the whole 4-byte BUFF reinterpreted as a Dword --
+		// F100's sub-function 2 only overwrites BUF0 (the low byte) with
+		// ECR, so BUF1 (the sub-function selector we sent, 0x02) is still
+		// sitting in the next byte up. Only BUF0 is the actual key code.
+		uint32 hotkeyCode = hotkeyResult & 0xFF;
+		TRACE("hotkey (handle 0x0100): read code %s, value 0x%02" B_PRIx32
+			"\n", strerror(hotkeyStatus), hotkeyCode);
+
+		// Empirically matched on real hardware by pressing Fn+F5 and
+		// Fn+F6 in isolation (an earlier guess, matching these codes to
+		// F2-F7 by the order all twelve Fn+Fn-row keys fired in, put
+		// brightness at 0x09/0x0a -- wrong, confirmed by this direct
+		// test): Fn+F5 -> 0x05/0x85, Fn+F6 -> 0x06/0x86. Which half of
+		// each pair is press vs. release isn't confirmed -- acting on the
+		// 0x80-clear code only, to fire once per key rather than twice.
+		// Direction (F5=down vs. up) isn't confirmed either; swap the two
+		// branches below if it turns out backwards.
+		//
+		// Volume and any display-output toggle keys have no equivalent
+		// ACPI method on this model -- nothing in the DSDT reads back or
+		// sets them the way GBRT/SBRT do for brightness -- so wiring
+		// those up would mean synthesizing input events for the
+		// input_server/media mixer, a materially bigger change than this
+		// driver's scope.
+		if (hotkeyCode == 0x05 && device->brightness > 0)
+			sony_ec_set_brightness(device, device->brightness - 1);
+		else if (hotkeyCode == 0x06)
+			sony_ec_set_brightness(device, device->brightness + 1);
+	} else {
+		// Handles other than 0x0124/0x0100 aren't acted on yet. Log which
+		// handle each one is so it can be matched to a real Fn-key press
+		// from syslog before wiring up a handler.
+		TRACE("unhandled notify event, handle 0x%04x\n",
+			device->capabilities[offset]);
+	}
+}
+
+
+//	#pragma mark - device module API
