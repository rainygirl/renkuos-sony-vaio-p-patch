+		sc->sc_bmiss_count = 0;
+
+		/*
+		 * Full re-init: the chip kept nothing across the power cycle.
+		 * HAL_RESET_FORCE_COLD, not HAL_RESET_COLD -- the latter belongs
+		 * to a different, unnamed enum in ah.h and is not one of the
+		 * HAL_RESET_TYPE values ath_reset() takes.
+		 */
+		ath_reset(sc, ATH_RESET_FULL, HAL_RESET_FORCE_COLD);
