+		// the failure surfaces much later as a "double free" when a stale
+		// pointer is handed to delete. Seen for real once a consumer started
+		// draining stale frames in a tight loop, which turned a rare race
+		// into a frequent one.
+		BAutolock l(fLocker);
+		fFrames.AddItem(fCurrentFrame);
