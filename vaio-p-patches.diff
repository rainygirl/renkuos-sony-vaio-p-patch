+
+static status_t
+sony_ec_init_driver(device_node *node, void **_driverCookie)
+{
+	*_driverCookie = node;
+	return B_OK;
+}
+
+
+static void
+sony_ec_uninit_driver(void *driverCookie)
+{
+	if (sSonyEcDevice == NULL)
+		return;
+
+	sSonyEcDevice->acpi->remove_notify_handler(sSonyEcDevice->acpi_cookie,
+		ACPI_DEVICE_NOTIFY, sony_ec_notify_handler);
+	free(sSonyEcDevice);
+	sSonyEcDevice = NULL;
+}
+
+
+static status_t
+sony_ec_deferred_bt_power_on(void *_device)
+{
+	sony_ec_device_info *device = (sony_ec_device_info *)_device;
+
+	// Well past the boot-time USB/ATA enumeration window; see the comment
+	// at the spawn site.
+	snooze(10000000);
+
+	if (sSonyEcDevice != device)
+		return B_OK;
+
+	uint32 btPowerResult = 0;
+	status_t btPowerStatus = sony_ec_call_handle(device, 0x0124, 0x030600,
+		&btPowerResult);
+	uint32 btStateResult = 0;
+	sony_ec_call_handle(device, 0x0124, 0x0500, &btStateResult);
+	TRACE("boot-time BT power on: %s, readback 0x%04" B_PRIx32 "\n",
+		strerror(btPowerStatus), btStateResult);
+	return B_OK;
+}
+
+
+static status_t
+sony_ec_register_child_devices(void *_cookie)
+{
+	device_node *node = (device_node *)_cookie;
+
+	// Set up (and probe) the device here, unconditionally, rather than in
+	// init_device(): init_device() is only called once something actually
+	// opens power/sony_ec/0, and nothing does that on its own -- this is a
+	// bring-up/diagnostic driver that needs its capability table logged
+	// and its notify handler installed at boot regardless of whether any
+	// client ever opens the device node.
+	sony_ec_device_info *device = (sony_ec_device_info *)calloc(1,
+		sizeof(*device));
+	if (device == NULL)
+		return B_NO_MEMORY;
+
+	device->node = node;
+
+	device_node *parent = sDeviceManager->get_parent_node(node);
+	sDeviceManager->get_driver(parent, (driver_module_info **)&device->acpi,
+		(void **)&device->acpi_cookie);
+	sDeviceManager->put_node(parent);
+
+	if (device->acpi == NULL) {
+		ERROR("could not get acpi device driver from parent node\n");
+		free(device);
+		return B_ERROR;
+	}
+
+	if (device->acpi->install_notify_handler(device->acpi_cookie,
+			ACPI_DEVICE_NOTIFY, sony_ec_notify_handler, device) != B_OK) {
+		ERROR("can't install notify handler\n");
+	}
+
+	sony_ec_probe_capabilities(device);
+	sony_ec_init_backlight();
+
+	sSonyEcDevice = device;
+
+	// Enable Bluetooth module power once at boot, deferred well past the
+	// boot-time USB/ATA enumeration window (an EC call made synchronously
+	// right here was observed to collide with it). The EC never turns
+	// H8EC.BTPW on by itself, so without this the module sits half-powered
+	// (presence pull-up on standby power, logic dead) -- and a half-
+	// powered device on the bus is exactly what was observed to babble
+	// the companion UHCI controller into "host process error" halts
+	// during every boot's enumeration attempts. The notify handler also
+	// re-requests BT power on every wireless-switch toggle, mirroring the
+	// WLAN handling.
+	thread_id thread = spawn_kernel_thread(sony_ec_deferred_bt_power_on,
+		"sony_ec bt power on", B_LOW_PRIORITY, device);
+	if (thread >= 0)
+		resume_thread(thread);
+
+	return sDeviceManager->publish_device(node, "power/sony_ec/0",
+		SONY_EC_DEVICE_MODULE_NAME);
+}
