+	 * gone. Every register access after that reads open bus, which is exactly
+	 * what an unbroken run of bb hangs looks like.
+	 *
+	 * Hence: save the header, put it back, and check that the device answers.
+	 * Then re-initialise properly -- the ATH_RESET_NOLOSS below preserves the
+	 * link and assumes the chip kept its state, which after a power cycle it
+	 * certainly has not.
+	 *
+	 * And at most once. If a power cycle does not rescue the adapter, another
+	 * one will not either, and each attempt is a fresh chance to leave the
+	 * card unreachable until reboot.
+	 */
+	if (!associated && sc->sc_bmiss_count >= 3 && !sc->sc_did_power_cycle
+	    && pci_get_vendor(sc->sc_dev) == 0x168c
+	    && pci_get_device(sc->sc_dev) == 0x002a) {
+		uint32_t config[16];
+		uint32_t id;
+		int i;
+
+		sc->sc_did_power_cycle = 1;
+		device_printf(sc->sc_dev,
+		    "repeated beacon miss recovery, power-cycling the "
+		    "adapter\n");
+
+		/* The whole type 0 header: BARs, command, cache line, latency. */
+		for (i = 0; i < 16; i++)
+			config[i] = pci_read_config(sc->sc_dev, i * 4, 4);
+
+		pci_set_powerstate(sc->sc_dev, PCI_POWERSTATE_D3);
+		DELAY(50000);
+		pci_set_powerstate(sc->sc_dev, PCI_POWERSTATE_D0);
+
+		/* Skip 0x00 (IDs) and 0x08 (class/revision): both read-only. */
+		for (i = 0; i < 16; i++) {
+			if (i == 0 || i == 2)
+				continue;
+			pci_write_config(sc->sc_dev, i * 4, config[i], 4);
+		}
+		pci_enable_busmaster(sc->sc_dev);
+
