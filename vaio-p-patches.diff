+	// BMallocIO::SetSize(0) frees the backing buffer but does NOT reset
+	// the write position, so without also seeking back to 0 here, every
+	// subsequent frame's payload would keep appending after all prior
+	// frames' data instead of starting fresh -- meaning FillFrameBuffer()
+	// would always end up decoding the very first frame ever captured
+	// (often a dark/black frame from the sensor's power-up/auto-exposure
+	// ramp-up) and never anything newer.
+	fInputBuffer.SetSize(0);
+	fInputBuffer.Seek(0, SEEK_SET);
