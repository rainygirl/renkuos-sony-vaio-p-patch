+	NULL,
+
+	sony_ec_open,
+	sony_ec_close,
+	sony_ec_free,
+	sony_ec_read,
+	sony_ec_write,
+	NULL,
+	sony_ec_control,
+	NULL,
+	NULL
+};
+
+module_info *modules[] = {
+	(module_info *)&sony_ec_driver_module,
+	(module_info *)&sony_ec_device_module,
+	(module_info *)&sSonyEcBacklightModule,
+	NULL
+};
