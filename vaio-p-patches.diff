+
+static status_t
+sony_ec_init_device(void *_cookie, void **cookie)
+{
+	// sSonyEcDevice is set up eagerly in sony_ec_register_child_devices(),
+	// since init_device() is only called once something actually opens
+	// power/sony_ec/0 -- and nothing does by default. We still want the
+	// capability table probed and the notify handler installed
+	// unconditionally at boot, not only if/when a client shows up.
+	if (sSonyEcDevice == NULL) {
+		ERROR("init_device called without a set up device\n");
+		return B_ERROR;
+	}
+
+	*cookie = sSonyEcDevice;
+	return B_OK;
+}
+
+
+static void
+sony_ec_uninit_device(void *_cookie)
+{
+	// The device is torn down in sony_ec_uninit_driver(), not here, since
+	// it was set up outside of the open()-triggered init_device() lifecycle
+	// too. Nothing to do per-close.
+}
+
+
+static status_t
+sony_ec_open(void *_cookie, const char *path, int flags, void **cookie)
+{
+	*cookie = _cookie;
+	return B_OK;
+}
+
+
+static status_t
+sony_ec_read(void *_cookie, off_t position, void *buffer, size_t *numBytes)
+{
+	sony_ec_device_info *device = (sony_ec_device_info *)_cookie;
+	if (*numBytes < sizeof(uint32)) {
+		*numBytes = 0;
+		return B_IO_ERROR;
+	}
+
+	if (user_memcpy(buffer, &device->brightness, sizeof(uint32)) < B_OK)
+		return B_BAD_ADDRESS;
+
+	*numBytes = sizeof(uint32);
+	return B_OK;
+}
+
+
+static void
+sony_ec_init_backlight(void)
+{
+	pci_info info;
+	for (long i = 0; sPci->get_nth_pci_info(i, &info) == B_OK; i++) {
+		if (info.vendor_id != POULSBO_GFX_VENDOR_ID
+			|| info.device_id != POULSBO_GFX_DEVICE_ID) {
+			continue;
+		}
+
+		sGfxBus = info.bus;
+		sGfxDevice = info.device;
+		sGfxFunction = info.function;
+		sGfxFound = true;
+
+		uint32 initial = sPci->read_pci_config(sGfxBus, sGfxDevice,
+			sGfxFunction, LBB_REGISTER_OFFSET, 1);
+		TRACE("backlight: found graphics controller at %u:%u:%u, "
+			"LBB=%" B_PRIu32 "\n", sGfxBus, sGfxDevice, sGfxFunction,
+			initial);
+		return;
+	}
+
+	TRACE("backlight: no Poulsbo graphics controller found\n");
+}
+
+
+static void
+sony_ec_set_backlight_lbb(uint32 level)
+{
+	if (!sGfxFound)
+		return;
+
+	uint32 value = (255 * level) / 8;
+	sPci->write_pci_config(sGfxBus, sGfxDevice, sGfxFunction,
+		LBB_REGISTER_OFFSET, 1, value);
+	TRACE("backlight: LBB set to %" B_PRIu32 "/255\n", value);
+}
+
+
+// Panel backlight power, exposed to the graphics driver through the optional
+// generic/backlight module. The VESA BIOS DPMS call cannot reach this panel's
+// backlight (it lives in an SCH chipset register), so without this, blanking
+// the screen leaves the backlight fully lit and only the image goes black --
+// which wastes almost all of the power the blank was supposed to save.
+//
+// The level is deliberately not pushed through SBRT here: this is a transient
+// power state, not a user brightness change, so the EC's notion of the current
+// brightness is left untouched and the panel comes back exactly as the user
+// had it.
+static uint32 sBacklightSavedLevel;
+static bool sBacklightOff;
+
+
+static status_t
+sony_ec_backlight_set_power(bool on)
+{
+	if (!sGfxFound)
+		return B_NOT_SUPPORTED;
+
+	if (on) {
+		if (!sBacklightOff)
+			return B_OK;
+		sBacklightOff = false;
+		sony_ec_set_backlight_lbb(sBacklightSavedLevel);
+		TRACE("backlight: restored to %" B_PRIu32 "\n", sBacklightSavedLevel);
+	} else {
+		if (sBacklightOff)
+			return B_OK;
+		sBacklightSavedLevel = sSonyEcDevice != NULL
+			? sSonyEcDevice->brightness : 8;
+		sBacklightOff = true;
+		sony_ec_set_backlight_lbb(0);
+		TRACE("backlight: off (saved level %" B_PRIu32 ")\n",
+			sBacklightSavedLevel);
+	}
+
+	return B_OK;
+}
+
+
+static backlight_module_info sSonyEcBacklightModule = {
+	{
+		BACKLIGHT_MODULE_NAME,
+		0,
+		NULL
+	},
+
+	sony_ec_backlight_set_power
+};
+
+
+static status_t
+sony_ec_set_brightness(sony_ec_device_info *device, uint32 level)
+{
+	if (level > 8)
+		level = 8;
+
+	sony_ec_set_backlight_lbb(level);
+
+	uint32 result = 0;
+	status_t status = sony_ec_call_int(device, "SBRT", true, level, &result);
+	if (status == B_OK) {
+		device->brightness = level;
+		TRACE("brightness set to %" B_PRIu32 " (SBRT)\n", level);
+	} else {
+		ERROR("SBRT failed: %s\n", strerror(status));
+	}
+
+	// Read the level straight back from the EC (not just device->brightness,
+	// which we just set locally): if this still reports the OLD value, SBRT
+	// is a no-op on this model at the ACPI level. If it reports the NEW
+	// value, the EC accepted it, but whatever's between the EC and the
+	// actual panel backlight isn't responding -- a different, hardware-
+	// level problem this driver can't do anything more about.
+	uint32 readBack = 0xffffffff;
+	status_t readStatus = sony_ec_call_int(device, "GBRT", false, 0,
+		&readBack);
+	TRACE("brightness read-back after SBRT: status %s, value %" B_PRIu32
+		"\n", strerror(readStatus), readBack);
+
+	return status;
+}
+
+
+static status_t
+sony_ec_write(void *_cookie, off_t position, const void *buffer,
+	size_t *numBytes)
+{
+	sony_ec_device_info *device = (sony_ec_device_info *)_cookie;
+
+	// Accept a brightness level as an ASCII decimal string (e.g. "5"), so
+	// it's directly testable from a shell with something like
+	// `echo 5 > /dev/power/sony_ec/0`, without needing a dedicated tool.
+	char text[8];
+	size_t length = *numBytes;
+	if (length >= sizeof(text))
+		length = sizeof(text) - 1;
+	if (user_memcpy(text, buffer, length) < B_OK)
+		return B_BAD_ADDRESS;
+	text[length] = '\0';
+
+	uint32 level = (uint32)strtoul(text, NULL, 10);
+	status_t status = sony_ec_set_brightness(device, level);
+
+	*numBytes = length;
+	return status;
+}
